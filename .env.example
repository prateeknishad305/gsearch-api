# Server port
PORT=3000

# Max Google requests per second (keep low to avoid IP blocks)
MAX_QPS=5

# How long to cache results in memory (ms)
CACHE_TTL_MS=300000

# ---- Proxies (optional) ----
# Comma-separated list of proxy URLs. Requests rotate through them.
# Each URL supports embedded auth: http://user:pass@host:port
PROXY_URLS=http://user:pass@host1:port,http://user:pass@host2:port
# OR a single proxy:
# PROXY_URL=http://user:pass@host:port

# Global proxy username/password (used if a URL above has no embedded auth)
PROXY_USER=
PROXY_PASS=

# Rotation mode: round-robin (default) or random
PROXY_ROTATE=round-robin
